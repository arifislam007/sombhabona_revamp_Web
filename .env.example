# Copy to .env and fill in real values before running docker compose.

POSTGRES_USER=sombhabona
POSTGRES_PASSWORD=change_me
POSTGRES_DB=sombhabona

HTTP_PORT=6085
NEXT_PUBLIC_SITE_URL=http://localhost:6085

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=info@sombhabona.org

# bKash Tokenized Checkout. These are bKash's PUBLIC sandbox test credentials (no real money).
# For live payments replace ALL FIVE with your production merchant values.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=sandboxTokenizedUser02
BKASH_PASSWORD=sandboxTokenizedUser02@12345
BKASH_APP_KEY=4f6o0cjiki2rfm34kfdadl1eqq
BKASH_APP_SECRET=2is7hdktrekvrbljjh44ll3d9l1dtjo4pasmjvs5vl5qr3fug4b

# Staff admin area at /admin (donations, messages, volunteers, subscribers).
# Leave empty to disable it. Use a long, unique password; changing it logs everyone out.
ADMIN_PASSWORD=

# Signs admin login cookies. Must be 32+ random characters and DIFFERENT from ADMIN_PASSWORD.
# Generate one with:  openssl rand -hex 32     (admin stays disabled until this is set)
ADMIN_SESSION_SECRET=

# How many reverse proxies sit in front of the app (nginx = 1; host nginx + Docker nginx = 2).
# Used to find the real visitor IP for rate limiting; a wrong value weakens or over-tightens limits.
TRUSTED_PROXY_HOPS=1

# Host address the web container port (8065) is published on. 127.0.0.1 = only a proxy on this
# same machine can reach it. Use 0.0.0.0 only if your proxy is on another machine.
WEB_BIND=127.0.0.1
